---
import "../styles/global.css";
interface Props { title?: string }
const { title = "Employee Directory" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Employee Directory - Fast, searchable org charts and employee data." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">
    <nav class="sticky top-0 z-10 border-b bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
        <a href="/" class="font-semibold tracking-tight">Employee Directory</a>
        <div class="flex gap-4 text-sm">
          <a href="/" class="hover:underline">Directory</a>
          <a href="/analytics" class="hover:underline">Analytics</a>
          <a href="http://localhost:8080/health" target="_blank" class="hover:underline">API Health</a>
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-6xl px-6 py-8">
      <slot />
    </main>
  </body>
</html>
