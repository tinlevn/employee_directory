---
import "../styles/global.css";
interface Props { title?: string }
const { title = "Employee Directory" } = Astro.props;
---
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Employee Directory - Fast, searchable employee data." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen bg-[#FFF5E0] text-[#141E46] dark:bg-[#131519] dark:text-slate-100 antialiased transition-colors duration-200">
    <nav class="sticky top-0 z-40 border-b border-[#E6DBC5] dark:border-[#2b303c] bg-[#FFF5E0]/90 dark:bg-[#1c1f26]/90 backdrop-blur-md transition-colors duration-200">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-[#141E46] dark:text-white hover:opacity-90 transition-opacity">
          <span class="flex h-3 w-3 rounded-full bg-[#41B06E] dark:bg-[#1DCD9F] shadow-[0_0_8px_rgba(65,176,110,0.6)] dark:shadow-[0_0_8px_rgba(29,205,159,0.6)]"></span>
          <span>Employee<span class="text-[#41B06E] dark:text-[#1DCD9F]">Directory</span></span>
        </a>
        <div class="flex items-center gap-5 text-sm font-medium">
          <a href="/" class="text-[#141E46] dark:text-slate-300 hover:text-[#41B06E] dark:hover:text-[#1DCD9F] transition-colors">Directory</a>
          <a href="/analytics" class="text-[#141E46] dark:text-slate-300 hover:text-[#41B06E] dark:hover:text-[#1DCD9F] transition-colors">Analytics</a>
          <a href="http://localhost:8080/health" target="_blank" class="text-[#141E46] dark:text-slate-300 hover:text-[#41B06E] dark:hover:text-[#1DCD9F] transition-colors flex items-center gap-1">
            API Health
            <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle theme"
            title="Toggle theme mode"
            class="ml-2 rounded-lg border border-[#E6DBC5] dark:border-[#2b303c] p-2 text-[#141E46] dark:text-slate-300 hover:bg-[#F7EEDD] dark:hover:bg-[#252a34] hover:text-[#41B06E] dark:hover:text-[#1DCD9F] transition-colors focus:outline-none flex items-center justify-center cursor-pointer"
          >
            <!-- Moon Stars Icon (Shown in Light Mode to switch to Dark Mode) -->
            <svg id="theme-toggle-moon-stars" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21q-3.75 0-6.375-2.625T3 12q0-3.75 2.625-6.375T12 3q.35 0 .688.025t.662.075q-1.025.9-1.587 2.163T11.2 8q0 2.425 1.7 4.125T17 13.8q1.3 0 2.563-.562T21.725 11.65q.05.325.075.663T21.8 13q0 3.75-2.625 6.375T12 21Zm7.25-11.25l-.7-1.55-1.55-.7 1.55-.7.7-1.55.7 1.55 1.55.7-1.55.7-.7 1.55zm-3-4.5l-.45-1-.1-1 1-.45-1-.45-.45-1-.45 1-1 .45 1 .45.45 1z"/>
            </svg>
            <!-- Material Symbols Sunny Icon (Shown in Dark Mode to switch to Light Mode) -->
            <svg id="theme-toggle-sun" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 17q-2.075 0-3.537-1.463T7 12q0-2.075 1.463-3.537T12 7q2.075 0 3.538 1.463T17 12q0 2.075-1.463 3.538T12 17Zm0-2q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15Zm0 7q-.425 0-.712-.288T11 21v-2q0-.425.288-.712T12 18q.425 0 .713.288T13 19v2q0 .425-.288.713T12 22Zm0-18q-.425 0-.712-.288T11 3V1q0-.425.288-.712T12 0q.425 0 .713.288T13 1v2q0 .425-.288.713T12 4Zm8 9q-.425 0-.712-.288T19 12q0-.425.288-.712T20 11h2q.425 0 .713.288T23 12q0 .425-.288.713T22 13h-2ZM2 13q-.425 0-.712-.288T1 12q0-.425.288-.712T2 11h2q.425 0 .713.288T5 12q0 .425-.288.713T4 13H2Zm15.65 6.65q-.3-.3-.3-.712t.3-.713l1.4-1.4q.3-.3.713-.3t.712.3q.3.3.3.713t-.3.712l-1.4 1.4q-.3.3-.712.3t-.713-.3ZM4.925 6.35q-.3-.3-.3-.712t.3-.713l1.4-1.4q.3-.3.713-.3t.712.3q.3.3.3.713t-.3.712l-1.4 1.4q-.3.3-.712.3t-.713-.3ZM18.35 6.35q-.3-.3-.3-.712t.3-.713l1.4-1.4q.3-.3.713-.3t.712.3q.3.3.3.713t-.3.712l-1.4 1.4q-.3.3-.712.3t-.713-.3ZM4.925 19.65q-.3-.3-.3-.712t.3-.713l1.4-1.4q.3-.3.713-.3t.712.3q.3.3.3.713t-.3.712l-1.4 1.4q-.3.3-.712.3t-.713-.3Z"/>
            </svg>
          </button>
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-6xl px-6 py-8">
      <slot />
    </main>
    <script is:inline>
      const moonStarsIcon = document.getElementById('theme-toggle-moon-stars');
      const sunIcon = document.getElementById('theme-toggle-sun');
      const toggleBtn = document.getElementById('theme-toggle');

      function updateIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonStarsIcon?.classList.add('hidden');
        } else {
          moonStarsIcon?.classList.remove('hidden');
          sunIcon?.classList.add('hidden');
        }
      }
      updateIcons();

      toggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        updateIcons();
      });
    </script>
  </body>
</html>

