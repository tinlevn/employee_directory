---
import Layout from "../layouts/Layout.astro";
import Directory from "../components/Directory.tsx";
---

<Layout title="Directory — Employee Directory">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Directory</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      Go + Fiber API at <code class="rounded bg-slate-200/60 dark:bg-[#252a34] dark:text-[#1DCD9F] text-slate-800 px-1.5 py-0.5 text-xs font-mono border border-slate-300 dark:border-[#2b303c]">http://localhost:8080</code> — paginated, searchable, SCD2-aware.
    </p>
  </div>
  <Directory client:load />
</Layout>

