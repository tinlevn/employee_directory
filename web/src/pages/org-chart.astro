---
import Layout from "../layouts/Layout.astro";
import OrgChart from "../components/OrgChart.tsx";
---

<Layout title="Org Chart — Employee Directory">
  <div class="mb-6 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Organization Chart</h1>
      <p class="mt-1 text-sm text-zinc-600">
        Hierarchical view of the active workforce.
      </p>
    </div>
  </div>
  <OrgChart client:load />
</Layout>
